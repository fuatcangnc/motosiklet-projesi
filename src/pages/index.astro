---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { highlights, services, siteSettings, steps } from "../data/site";

const base = import.meta.env.BASE_URL;

const posts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 3);

const dateFormat = new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={`${siteSettings.brandName} — ${siteSettings.tagline}`}>
	<section class="max-w-3xl">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">{siteSettings.tagline}</p>
		<h1 class="mt-4 text-5xl font-black tracking-[-0.06em] text-foreground sm:text-7xl">
			Çantanız ruhsatta yazsın.
		</h1>
		<p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">{siteSettings.description}</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a class="inline-flex min-h-12 items-center bg-primary px-6 text-xs font-black uppercase tracking-wider text-white hover:bg-primary-dark" href="#contact">Teklif al</a>
			<a class="inline-flex min-h-12 items-center border border-border px-6 text-xs font-black uppercase tracking-wider text-foreground hover:border-primary hover:text-primary" href="#services">Hizmetleri gör</a>
		</div>
		<dl class="mt-12 grid gap-4 border-t border-border pt-6 sm:grid-cols-3">
			<div>
				<dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Ortalama süre</dt>
				<dd class="mt-1 text-2xl font-black tracking-tight text-foreground">3 iş günü</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Tamamlanan işlem</dt>
				<dd class="mt-1 text-2xl font-black tracking-tight text-foreground">1.200+</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Kapsam</dt>
				<dd class="mt-1 text-2xl font-black tracking-tight text-foreground">İstanbul & çevre iller</dd>
			</div>
		</dl>
	</section>

	<section id="services" class="mt-24 border-t border-border pt-12">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">Hizmetler</p>
		<h2 class="mt-3 text-3xl font-black tracking-tight text-foreground">Çanta işletmesinden tesciline kadar.</h2>
		<div class="mt-8 grid gap-4 sm:grid-cols-3">
			{
				services.map((item, index) => (
					<div class="border border-border p-5">
						<span class="font-mono text-xs text-primary">{String(index + 1).padStart(2, "0")}</span>
						<h3 class="mt-4 font-bold text-foreground">{item.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section id="about" class="mt-24 border-t border-border pt-12">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">Hakkımızda</p>
		<h2 class="mt-3 text-3xl font-black tracking-tight text-foreground">Tek işi çanta ruhsatı olan bir ekip.</h2>
		<div class="mt-8 grid gap-4 sm:grid-cols-3">
			{
				highlights.map((item) => (
					<div class="border border-border bg-muted/40 p-5">
						<h3 class="font-bold text-foreground">{item.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
					</div>
				))
			}
		</div>
		<div class="mt-8 grid gap-4 sm:grid-cols-4">
			{
				steps.map((step, index) => (
					<div class="border-t-2 border-primary pt-4">
						<span class="font-mono text-xs text-primary">{String(index + 1).padStart(2, "0")}</span>
						<h3 class="mt-2 text-sm font-bold text-foreground">{step.title}</h3>
						<p class="mt-1 text-sm leading-relaxed text-muted-foreground">{step.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section id="blog" class="mt-24 border-t border-border pt-12">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">Blog</p>
				<h2 class="mt-3 text-3xl font-black tracking-tight text-foreground">Süreçten notlar.</h2>
			</div>
			<a class="text-xs font-black uppercase tracking-wider text-primary hover:text-primary-dark" href={`${base}blog/`}>Tüm yazılar</a>
		</div>
		{posts.length === 0 ? (
			<p class="mt-6 text-sm text-muted-foreground">Yakında yeni yazılar burada olacak.</p>
		) : (
			<div class="mt-8 grid gap-4 sm:grid-cols-3">
				{posts.map((post) => (
					<a class="group border border-border p-5 hover:border-primary" href={`${base}blog/${post.id}/`}>
						<span class="font-mono text-xs text-muted-foreground">{dateFormat.format(post.data.pubDate)}</span>
						<h3 class="mt-3 font-bold text-foreground group-hover:text-primary">{post.data.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
					</a>
				))}
			</div>
		)}
	</section>

	<section id="contact" class="mt-24 border-t border-border pt-12">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">İletişim</p>
		<h2 class="mt-3 text-3xl font-black tracking-tight text-foreground">Çantanızın fotoğrafını gönderin, aynı gün dönelim.</h2>
		<p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
			Marka, model ve çanta tipini yazmanız yeterli. Uygunluk ve fiyat bilgisini WhatsApp üzerinden iletiyoruz.
		</p>
		<div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm">
			<a class="text-lg font-bold text-primary hover:text-primary-dark" href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
			<a class="font-bold text-foreground hover:text-primary" href={`tel:${siteSettings.phone.replace(/\s/g, "")}`}>{siteSettings.phone}</a>
			<span class="text-muted-foreground">{siteSettings.location}</span>
		</div>
		<p class="mt-3 text-xs text-muted-foreground">{siteSettings.hours}</p>
	</section>
</Base>
